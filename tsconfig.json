{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"strictNullChecks": true,
		"types": ["vite/client", "astro/client"],
		"target": "ES2020",
		"module": "ESNext",
		"skipLibCheck": true
	},
	"include": ["src/**/*", "node_modules/astro/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}
