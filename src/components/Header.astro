</div>
<style lang="scss">
	@use "../styles/variables.scss" as *;
	@use "../styles/components/button.scss" as *;

	html.light {
		.header-banner {
			outline: 0.2rem $light2 solid;
			background-color: $light;

			.divider {
				background-color: $light3;
			}
		}

		.logo-font {
			fill: $dark1 !important;
		}
	}

	.header-banner {
		display: flex;
		gap: 1.25rem;
		align-items: center;
		justify-content: center;
		margin: 1em 2.4rem;
		outline: 0.2rem $dark3 solid;
		border-radius: 1rem;
		background-color: $dark2;
		padding: 1rem 0;
		max-width: calc($article-width - 2.4rem * 2);

		.logo-container {
			width: 90px;

			svg {
				display: block;
				width: 100%;
				height: auto;
			}
		}

		.divider {
			border-radius: 1rem;
			background-color: $dark3;
			width: 0.3rem;
			height: 5rem;
		}

		p {
			text-align: left;
			line-height: 2.25ch;
			font-family: $code-font;
			font-size: 2.2rem;
		}

		@media screen and (width >= 400px) {
			.logo-container {
				width: 100px;
			}

			.divider {
				height: 6rem;
			}

			p {
				font-size: 2.4rem;
			}
		}
	}

	.other-links {
		display: grid;
		grid-template-columns: 1fr 1fr;
		margin: 0 1em; // fixme: magic value
	}

	.button {
		margin: 0.5em;
		height: fit-content;
		text-align: center;

		&:nth-of-type(1) {
			grid-row: 1;
			grid-column: span 2;
		}

		&:nth-of-type(2) {
			grid-row: 2;
			grid-column: 2;
		}

		&:nth-of-type(3) {
			grid-row: 2;
			grid-column: 3;
		}
	}

	@media screen and (min-width: $medium) {
		.header-banner {
			.logo-container {
				width: 125px;
			}

			p {
				font-size: 2.5rem;
			}
		}

		.other-links {
			grid-template-columns: 1fr 1fr 1fr;
			gap: 0 2rem;
			margin: 0 1.6rem;

			.button {
				margin: 0.5em;
				height: fit-content;
				text-align: center;

				&:nth-of-type(1) {
					grid-row: 1;
					grid-column: 2;
				}

				&:nth-of-type(2) {
					grid-row: 1;
					grid-column: 3;
				}

				&:nth-of-type(3) {
					grid-row: 1;
					grid-column: 1;
				}
			}
		}
	}
</style>
